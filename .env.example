# PhotoShare configuration inventory for the implemented backend and planned frontend/deployment.
# Placeholders only. Replace in ignored local configuration or a host secret facility.
# See docs/DEPLOYMENT.md for meanings, proposed defaults, and conditional storage fields.
# Never expose backend secrets through VITE_ variables.

APP_PROFILE=<local-test-or-production-profile>
PORT=<backend-port>
FRONTEND_ORIGIN=<frontend-origin>
APP_ALLOWED_ORIGINS=<comma-separated-exact-origins>
VITE_API_BASE_URL=<frontend-visible-api-base>

DB_JDBC_URL=<mysql-jdbc-url-with-required-tls-settings>
DB_USERNAME=<database-application-username>
DB_PASSWORD=<database-password>

JWT_ISSUER=<token-issuer>
STAFF_JWT_SECRET_BASE64=<base64-of-at-least-32-random-bytes>
GALLERY_JWT_SECRET_BASE64=<different-base64-signing-key>
STAFF_JWT_TTL_SECONDS=<staff-token-lifetime-seconds>
GALLERY_GRANT_TTL_SECONDS=<gallery-grant-lifetime-seconds>
RATE_LIMIT_WINDOW_SECONDS=<rate-window-seconds>
LOGIN_RATE_LIMIT_ATTEMPTS=<per-account-and-ip-limit>
LOGIN_RATE_LIMIT_IP_ATTEMPTS=<per-ip-login-limit>
PIN_RATE_LIMIT_ATTEMPTS=<per-gallery-and-ip-limit>
PIN_RATE_LIMIT_IP_ATTEMPTS=<per-ip-pin-limit>
REGISTRATION_RATE_LIMIT_ATTEMPTS=<per-ip-registration-limit>
MEMBER_PROVISION_RATE_LIMIT_ATTEMPTS=<per-admin-provision-limit>

STORAGE_DRIVER=<local-or-cloudinary>
CLOUDINARY_CLOUD_NAME=<cloudinary-product-environment-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
LOCAL_STORAGE_ROOT=<absolute-local-only-private-storage-path>
MAX_FILE_SIZE_BYTES=<maximum-photo-bytes>
MAX_REQUEST_SIZE_BYTES=<maximum-multipart-request-bytes>
MAX_FILES_PER_UPLOAD=<maximum-files-per-request>
MAX_IMAGE_PIXELS=<maximum-decoded-pixels>
